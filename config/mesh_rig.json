{
  "version": 3,
  "renderer": "webgl-hybrid-articulated-v4",
  "grid": { "columns": 24, "rows": 28 },
  "fallback": "canvas-raster",
  "assetStrategy": "generated-emotion-endpoints + articulated-mid-transition + emotion-aware-visemes",
  "articulatedSources": ["stand", "jump", "peace"],
  "generatedReferenceEmotions": ["neutral", "happy", "excited", "angry", "embarrassed", "sad", "surprised", "scared", "teasing", "love"],
  "faceRig": {
    "emotionSpecificAnchors": true,
    "visemeSafeBounds": true,
    "generatedReferenceMouthAnchors": true,
    "runtimeMouthUnderpaint": true,
    "expressionChannelTiming": true
  },
  "transition": {
    "generatedEndpointArt": true,
    "articulatedMidArc": true,
    "opacityNormalizedHandoff": true
  },
  "notes": "v0.4.0-alpha.1 uses ten generated emotion reference endpoints for final-pose fidelity while retaining the articulated WebGL renderer through the middle of transitions. Generated faces use emotion-specific lip-sync anchors; the remaining emotions use the existing articulated face rig."
}
