{
  "version": 3,
  "renderer": "webgl-hybrid-articulated-v4",
  "grid": { "columns": 24, "rows": 28 },
  "fallback": "canvas-raster",
  "assetStrategy": "verified-generated-emotion-endpoints + articulated-mid-transition + emotion-aware-visemes",
  "articulatedSources": ["stand", "jump", "peace"],
  "generatedReferenceEmotions": ["neutral", "happy", "excited", "angry", "embarrassed", "surprised", "scared", "teasing", "love"],
  "articulatedFallbackEmotions": ["pleading", "relaxed", "sick", "annoyed", "sad", "smug", "confused"],
  "faceRig": {
    "emotionSpecificAnchors": true,
    "visemeSafeBounds": true,
    "generatedReferenceMouthAnchors": true,
    "runtimeMouthUnderpaint": true,
    "expressionChannelTiming": true
  },
  "transition": {
    "generatedEndpointArt": true,
    "articulatedMidArc": true,
    "opacityNormalizedHandoff": true
  },
  "notes": "v0.4.0-alpha.1 uses nine verified generated emotion reference endpoints for final-pose fidelity. Sad and six other states retain the articulated fallback path; all sixteen emotions retain emotion-aware lip-sync."
}
